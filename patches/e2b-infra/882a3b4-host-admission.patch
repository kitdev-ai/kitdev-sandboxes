@@ -0,0 +1,63 @@
+package admission
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+)
+
+type Config struct {
+	MaxLiveSandboxes   int
+	MaxConcurrentStarts int
+	MaxConcurrentBuilds int
+	MaxVCPU             int64
+	MaxRAMMB            int64
+	MaxDiskMB           int64
+}
+
+func positiveInt(name string) (int, error) {
+	raw, ok := os.LookupEnv(name)
+	if !ok || raw == "" {
+		return 0, fmt.Errorf("required host admission setting %s is missing", name)
+	}
+	value, err := strconv.Atoi(raw)
+	if err != nil || value < 1 {
+		return 0, fmt.Errorf("host admission setting %s must be a positive integer", name)
+	}
+	return value, nil
+}
+
+func Load() (Config, error) {
+	var result Config
+	inputs := []struct {
+		name   string
+		target *int
+	}{
+		{"KITDEV_MAX_LIVE_SANDBOXES", &result.MaxLiveSandboxes},
+		{"KITDEV_MAX_CONCURRENT_STARTS", &result.MaxConcurrentStarts},
+		{"KITDEV_MAX_CONCURRENT_BUILDS", &result.MaxConcurrentBuilds},
+	}
+	for _, input := range inputs {
+		value, err := positiveInt(input.name)
+		if err != nil {
+			return Config{}, err
+		}
+		*input.target = value
+	}
+	resources := []struct {
+		name   string
+		target *int64
+	}{
+		{"KITDEV_MAX_VCPU", &result.MaxVCPU},
+		{"KITDEV_MAX_RAM_MB", &result.MaxRAMMB},
+		{"KITDEV_MAX_DISK_MB", &result.MaxDiskMB},
+	}
+	for _, input := range resources {
+		value, err := positiveInt(input.name)
+		if err != nil {
+			return Config{}, err
+		}
+		*input.target = int64(value)
+	}
+	return result, nil
+}
