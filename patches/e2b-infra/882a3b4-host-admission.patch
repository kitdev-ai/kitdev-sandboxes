@@ -0,0 +1,49 @@
+package admission
+
+import "testing"
+
+var validEnvironment = map[string]string{
+	"KITDEV_MAX_LIVE_SANDBOXES":    "1",
+	"KITDEV_MAX_CONCURRENT_STARTS": "1",
+	"KITDEV_MAX_CONCURRENT_BUILDS": "1",
+	"KITDEV_MAX_VCPU":              "2",
+	"KITDEV_MAX_RAM_MB":            "8192",
+	"KITDEV_MAX_DISK_MB":           "25600",
+}
+
+func setValidEnvironment(t *testing.T) {
+	t.Helper()
+	for name, value := range validEnvironment {
+		t.Setenv(name, value)
+	}
+}
+
+func TestLoadRequiresEverySetting(t *testing.T) {
+	setValidEnvironment(t)
+	t.Setenv("KITDEV_MAX_RAM_MB", "")
+	if _, err := Load(); err == nil {
+		t.Fatal("expected missing setting to fail")
+	}
+}
+
+func TestLoadRejectsInvalidSetting(t *testing.T) {
+	setValidEnvironment(t)
+	t.Setenv("KITDEV_MAX_CONCURRENT_BUILDS", "0")
+	if _, err := Load(); err == nil {
+		t.Fatal("expected non-positive setting to fail")
+	}
+}
+
+func TestLoadReturnsExactSettings(t *testing.T) {
+	setValidEnvironment(t)
+	config, err := Load()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if config.MaxLiveSandboxes != 1 || config.MaxConcurrentStarts != 1 || config.MaxConcurrentBuilds != 1 {
+		t.Fatalf("unexpected concurrency settings: %+v", config)
+	}
+	if config.MaxVCPU != 2 || config.MaxRAMMB != 8192 || config.MaxDiskMB != 25600 {
+		t.Fatalf("unexpected resource settings: %+v", config)
+	}
+}
diff --git a/orchestrator/pkg/admission/slots.go b/orchestrator/pkg/admission/slots.go
new file mode 100644
index 0000000..2ca5f18
--- /dev/null
+++ b/orchestrator/pkg/admission/slots.go
@@ -0,0 +1,17 @@
+package admission
+
+import "sync/atomic"
+
+func Acquire(counter *atomic.Int64, limit int64) (release func(), ok bool) {
+	if counter.Add(1) > limit {
+		counter.Add(-1)
+		return nil, false
+	}
+
+	var released atomic.Bool
+	return func() {
+		if released.CompareAndSwap(false, true) {
+			counter.Add(-1)
+		}
+	}, true
+}
diff --git a/orchestrator/pkg/admission/slots_test.go b/orchestrator/pkg/admission/slots_test.go
new file mode 100644
index 0000000..d864e5b
--- /dev/null
+++ b/orchestrator/pkg/admission/slots_test.go
@@ -0,0 +1,59 @@
+package admission
+
+import (
+	"sync"
+	"sync/atomic"
+	"testing"
+)
+
+func TestAcquireHonorsBoundaryUnderContention(t *testing.T) {
+	const contenders = 32
+	const limit = 3
+	var counter atomic.Int64
+	var workers sync.WaitGroup
+	start := make(chan struct{})
+	releaseGate := make(chan struct{})
+	results := make(chan bool, contenders)
+
+	for range contenders {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			<-start
+			release, ok := Acquire(&counter, limit)
+			results <- ok
+			if ok {
+				<-releaseGate
+				release()
+			}
+		}()
+	}
+	close(start)
+	successes := 0
+	for range contenders {
+		if <-results {
+			successes++
+		}
+	}
+	if successes != limit {
+		t.Fatalf("acquired %d slots, want %d", successes, limit)
+	}
+	close(releaseGate)
+	workers.Wait()
+	if counter.Load() != 0 {
+		t.Fatalf("counter after release is %d", counter.Load())
+	}
+}
+
+func TestReleaseIsIdempotent(t *testing.T) {
+	var counter atomic.Int64
+	release, ok := Acquire(&counter, 1)
+	if !ok {
+		t.Fatal("expected slot")
+	}
+	release()
+	release()
+	if counter.Load() != 0 {
+		t.Fatalf("counter after double release is %d", counter.Load())
+	}
+}
