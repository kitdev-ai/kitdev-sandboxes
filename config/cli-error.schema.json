{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kitdev-sandboxes:cli-error:v1",
  "title": "kitdev CLI error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "error"],
  "properties": {
    "schema_version": { "const": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["invalid_invocation", "invalid_configuration", "internal_error", "interrupted"]
        },
        "message": { "type": "string" }
      }
    }
  }
}
