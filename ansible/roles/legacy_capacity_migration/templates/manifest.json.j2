{
  "schema_version": 1,
  "owner": "kitdev-sandboxes/legacy-capacity-migration",
  "platform": {
    "version": {{ ansible_facts.distribution_version | to_json }},
    "lifecycle_mode": {{ kitdev_lifecycle_mode | to_json }}
  },
  "legacy_file": {
    "path": {{ kitdev_legacy_hugepage_file | to_json }},
    "sha256": {{ kitdev_final_hugepage_file.stat.checksum | to_json }}
  },
  "capacity": {
    "max_sandbox_memory_mib": {{ kitdev_capacity_max_sandbox_memory_mib | int }},
    "concurrent_hugepage_sandboxes": {{ kitdev_capacity_concurrent_hugepage_sandboxes | int }},
    "build_snapshot_headroom_mib": {{ kitdev_capacity_build_snapshot_headroom_mib | int }},
    "hugepage_pool_mib": {{ kitdev_capacity_plan.hugepage_pool_mib | int }},
    "hugepages_2m": {{ kitdev_capacity_plan.hugepages_2m | int }},
    "normal_memory_reserve_mib": {{ kitdev_hugepages_min_available_mb_after | int }},
    "max_ram_percent": {{ kitdev_hugepages_max_ram_percent | int }}
  },
  "verification": {{ kitdev_final_capacity_verification.stdout | from_json | to_json }}
}
